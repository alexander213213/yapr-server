# Copy to .env for local dev (never commit .env).
# Railway / production injects PORT directly; --env-file is dev-only.
PORT=9000
# TLS is required (fail-closed, no plaintext fallback).
# Dev: run `npm run certs`, then keep these two lines.
TLS_CERT_FILE=./certs/dev-cert.pem
TLS_KEY_FILE=./certs/dev-key.pem
# Production alternative: inline PEM via TLS_CERT / TLS_KEY env vars.
# Account recovery tokens (server-sealed bearer envelopes for reclaiming your
# user id after server data loss). Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Back it up offsite alongside the TLS key. Unset = recovery off (no crash).
# YAPR_RECLAIM_KEY=
# LOG_LEVEL=info
