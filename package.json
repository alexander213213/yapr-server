{
  "name": "yapr-server",
  "version": "1.0.0",
  "description": "Relay-only inbox for yapr terminal chat (Node 22, ESM-safe CJS build)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx --env-file=.env src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "vitest run",
    "certs": "bash scripts/gen-dev-certs.sh"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pino": "^9.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
